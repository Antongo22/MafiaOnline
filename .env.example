# ============================================
# Mafia Game - Environment Configuration
# ============================================
# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env
# ============================================

# --- LiveKit Configuration ---
# Получите эти значения после регистрации на https://cloud.livekit.io
# Или используйте свой LiveKit сервер
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=your-api-secret-here
LIVEKIT_WS_URL=wss://calls.trexon.ru/livekit

# --- Calls Service Configuration ---
# URL API сервиса видеозвонков
CALLS_API_URL=https://calls.trexon.ru/

# --- Master Admin Key ---
# Ключ для административного доступа к управлению медиа
# ВАЖНО: Используйте тот же ключ что и в calls/.env!
# python -c "import secrets; print(secrets.token_urlsafe(32))"
MASTER_ADMIN_KEY=your-master-admin-key-here
