# ============================================
# Mafia Game - Environment Configuration
# ============================================
# Скопируйте этот файл в .env и заполните значения
# cp .env.example .env
# ============================================

# --- Calls Service Configuration ---
# URL API сервиса видеозвонков
CALLS_API_URL=https://calls.trexon.ru/

# --- Master Admin Key ---
# Ключ для административного доступа к управлению медиа
# ВАЖНО: Используйте тот же ключ что и в calls/.env!
# python -c "import secrets; print(secrets.token_urlsafe(32))"
MASTER_ADMIN_KEY=your-master-admin-key-here

# --- Game Settings ---
# Минимальное количество игроков для старта игры
MIN_PLAYERS=3
